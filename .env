# Django settings
SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=orderCycleProject.settings_prod
ALLOWED_HOSTS=example.com,www.example.com

# Database settings
DB_NAME=orderProcess
DB_USER=postgres
DB_PASSWORD=secure-password-here
DB_HOST=db
DB_PORT=5432

# Optional: Tesseract and Poppler paths for OCR and PDF processing
TESSERACT_CMD=/usr/bin/tesseract
POPPLER_PATH=/usr/bin